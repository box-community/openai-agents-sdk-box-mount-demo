OPENAI_API_KEY=sk-...
BOX_CLIENT_ID=your-box-client-id
BOX_CLIENT_SECRET=your-box-client-secret
BOX_CONFIG_FILE=/absolute/path/to/box-config.json
BOX_SUB_TYPE=user
BOX_ROOT_FOLDER_ID=0

